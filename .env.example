# Copy to .env.local and fill in. Never commit real values.
# Stories that first need each variable are noted; unused ones can stay empty until then.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (S0-2) — local values come from `supabase start`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only: src/lib/supabase/admin.ts
DATABASE_URL=                     # Drizzle: migrations, seed, jobs. Bypasses RLS.

# PostHog (S0-5)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (S0-5)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                # build-time source map upload

# Upstash Redis — rate limiting (S2-4)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OpenAI — free moderation endpoint only (S2-4)
OPENAI_API_KEY=

# Resend — digest and intro emails (S5-7); auth emails are sent by Supabase via Resend SMTP
RESEND_API_KEY=
EMAIL_FROM=

# Vercel Cron → /api/cron/* (secret-protected)
CRON_SECRET=
